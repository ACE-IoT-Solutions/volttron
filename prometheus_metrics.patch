+BASIC_DR_APP_OP_CODES = {
+    "BasicDrMessage": "0801",
+    "IntermediateDrMessage": "0802",
+    "Shed": "01",
+    "EndShed": "02",
+    "BasicApplicationACK": "03",
+    "BasicApplicationNAK": "04",
+    "PowerLevelRequest": "06",
+    "RelativePriceIndicator": "07",
