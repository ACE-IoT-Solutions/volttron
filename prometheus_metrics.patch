+    Returns:
+    - dict: A dictionary containing the energy day chart data.
+    """
+
+    # Construct the URL using the given plant_id and date
+    url = f"https://openapi.mysolark.com/v1/plant/energy/{plant_id}/day?date={date}&lan={lan}"
